# ==============================================================================
# CẤU HÌNH MÔI TRƯỜNG GOM ĐƠN PRO ENTERPRISE
# ==============================================================================

# Cổng khởi chạy hệ thống (mặc định: 3000)
PORT=3000

# Môi trường chạy (development | production)
NODE_ENV=production

# Đường dẫn thư mục lưu trữ CSDL JSON (mặc định: ./data)
DATA_DIR=./data

# Cấu hình Bản quyền LicenseHub
LICENSEHUB_API_URL=https://licensehub.shop/api/v1/license
LICENSEHUB_APP_ID=ductinlogistics
LICENSE_KEY=

# Cấu hình Email gửi đối soát (Tùy chọn, có thể cài trực tiếp trong giao diện Cài đặt)
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=your_email@gmail.com
# SMTP_PASS=your_app_password
